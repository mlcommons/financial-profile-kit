{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:arp:1.0-rc2:profile-summary-0.3-draft",
  "title": "Agent Reliability Profile Summary, design draft 0.3 (for arp/1.0-rc2)",
  "description": "Design draft for the gated Profile Exchange. Derived by rule from an issued, conformant Profile. Admission establishes a signed, conformant submission from a registered organization; it does not verify derivation, which rests on the owner's attestation and sampled verification inside the institution.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "summary_id",
    "profile_hash",
    "profile_spec",
    "contributor_ref",
    "deployment_ref",
    "segment",
    "dates",
    "claim",
    "assurance",
    "signatures",
    "derivation"
  ],
  "properties": {
    "spec": {
      "const": "arp-summary/0.3-draft"
    },
    "summary_id": {
      "type": "string",
      "pattern": "^sum-[0-9a-f]{16}$"
    },
    "profile_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "Canonical hash of the full Profile, which stays with the institution."
    },
    "profile_spec": {
      "const": "arp/1.0-rc2"
    },
    "contributor_ref": {
      "type": "string",
      "pattern": "^c-[0-9a-z]{8,32}$",
      "description": "Opaque reference the Exchange issues when it verifies the organization. Never shown to viewers."
    },
    "deployment_ref": {
      "type": "string",
      "pattern": "^d-[0-9a-f]{16}$",
      "description": "Salted hash of the deployment id, so later versions of the same deployment replace earlier ones without revealing the id."
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "institution_type",
        "region"
      ],
      "properties": {
        "institution_type": {
          "enum": [
            "gsib",
            "large_bank",
            "mid_bank",
            "small_bank",
            "credit_union",
            "insurer",
            "asset_manager",
            "payments_fintech",
            "market_infrastructure",
            "other"
          ]
        },
        "region": {
          "enum": [
            "north_america",
            "eu",
            "uk",
            "apac",
            "latam",
            "middle_east_africa",
            "other"
          ]
        }
      }
    },
    "dates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_as_of_month",
        "issued_month"
      ],
      "properties": {
        "evidence_as_of_month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "issued_month": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "valid_until_month": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        }
      },
      "description": "Month precision only, to limit re-identification."
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "tier_basis",
        "approval_quality",
        "business_line",
        "use_case_id",
        "actions",
        "platform_anchored",
        "peer_controls"
      ],
      "properties": {
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4",
            "U"
          ]
        },
        "tier_basis": {
          "enum": [
            "asserted",
            "substantiated"
          ]
        },
        "approval_quality": {
          "enum": [
            "substantive",
            "reflexive",
            "not_assessed",
            "none_recorded"
          ]
        },
        "business_line": {
          "enum": [
            "retail_consumer_banking",
            "lending_credit",
            "payments",
            "financial_crime_compliance",
            "markets",
            "wealth_asset_management",
            "treasury_finance",
            "insurance",
            "internal_corporate"
          ]
        },
        "use_case_id": {
          "type": "string",
          "pattern": "^ODD\\.[0-9]{1,3}$"
        },
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "permitted",
            "prohibited"
          ],
          "properties": {
            "permitted": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5",
                  "A6",
                  "A7",
                  "A8",
                  "A9",
                  "A10",
                  "A11",
                  "A12"
                ]
              }
            },
            "prohibited": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "A1",
                  "A2",
                  "A3",
                  "A4",
                  "A5",
                  "A6",
                  "A7",
                  "A8",
                  "A9",
                  "A10",
                  "A11",
                  "A12"
                ]
              }
            }
          }
        },
        "platform_anchored": {
          "type": "boolean",
          "description": "True if the Profile is anchored to a Platform Baseline Profile. The platform is not identified."
        },
        "peer_controls": {
          "type": "object",
          "additionalProperties": false,
          "description": "Status of each control in vocab/peer-control-set.json. tested_other = tested but not shown to hold (contradicted, held only by the agent's choice, or not established); subject to disclosure review.",
          "patternProperties": {
            "^(model|tool|harness|environment|inter_agent|control_plane)\\.[a-z0-9_]+$": {
              "enum": [
                "not_declared",
                "not_applicable",
                "absent",
                "not_established",
                "asserted",
                "configured",
                "tested_held",
                "tested_other"
              ]
            }
          }
        }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axes",
        "headline",
        "assessor_roles",
        "comparability_flag",
        "disclosures"
      ],
      "properties": {
        "axes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "odd",
            "actions",
            "controls"
          ],
          "properties": {
            "autonomy": {
              "enum": [
                1,
                2,
                3
              ]
            },
            "odd": {
              "enum": [
                1,
                2,
                3
              ]
            },
            "actions": {
              "enum": [
                1,
                2,
                3
              ]
            },
            "controls": {
              "enum": [
                1,
                2,
                3
              ]
            }
          }
        },
        "headline": {
          "enum": [
            1,
            2,
            3
          ]
        },
        "assessor_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "autonomy",
            "odd",
            "actions",
            "controls"
          ],
          "description": "Who stands behind each axis (institution, or an independent assessor at Level 3). Assessor names do not travel with the summary.",
          "properties": {
            "autonomy": {
              "enum": [
                "institution",
                "independent_assessor"
              ]
            },
            "odd": {
              "enum": [
                "institution",
                "independent_assessor"
              ]
            },
            "actions": {
              "enum": [
                "institution",
                "independent_assessor"
              ]
            },
            "controls": {
              "enum": [
                "institution",
                "independent_assessor"
              ]
            }
          }
        },
        "comparability_flag": {
          "type": "boolean"
        },
        "disclosures": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "level1_untested",
              "self_tested",
              "independently_verified",
              "not_comparable",
              "benchmark_not_production"
            ]
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autonomy": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_fields",
                "tested",
                "judged"
              ],
              "properties": {
                "claim_fields": {
                  "type": "integer",
                  "minimum": 0
                },
                "tested": {
                  "type": "integer",
                  "minimum": 0
                },
                "judged": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "odd": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_fields",
                "tested",
                "judged"
              ],
              "properties": {
                "claim_fields": {
                  "type": "integer",
                  "minimum": 0
                },
                "tested": {
                  "type": "integer",
                  "minimum": 0
                },
                "judged": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "actions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_fields",
                "tested",
                "judged"
              ],
              "properties": {
                "claim_fields": {
                  "type": "integer",
                  "minimum": 0
                },
                "tested": {
                  "type": "integer",
                  "minimum": 0
                },
                "judged": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "controls": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "claim_fields",
                "tested",
                "judged"
              ],
              "properties": {
                "claim_fields": {
                  "type": "integer",
                  "minimum": 0
                },
                "tested": {
                  "type": "integer",
                  "minimum": 0
                },
                "judged": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "alg",
          "public_key",
          "signed_hash",
          "value"
        ],
        "properties": {
          "role": {
            "const": "owner"
          },
          "alg": {
            "const": "ed25519"
          },
          "public_key": {
            "type": "string"
          },
          "signed_hash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "description": "Signed with the owner key registered with the Exchange. No signer name travels with the summary."
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "tool_version",
        "owner_attestation"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "tool_version": {
          "type": "string",
          "minLength": 1
        },
        "owner_attestation": {
          "const": "I attest that this Summary was derived by the named tool, without alteration, from the issued Profile identified by profile_hash."
        }
      }
    }
  },
  "$comment": "Design only: needed only if the Profile Exchange passes its gate. Status: release candidate 2 of arp/1.0, prepared by the MLCommons Financial Services Working Group for pilot use and comment. Not a final MLCommons standard, certification scheme or endorsement. Field names and rules may change before 1.0."
}
