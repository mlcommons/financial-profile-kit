        "customer_market_impact": "Indirect: dispositions affect customers only after analyst approval",
        "stack_composability": "predefined",
        "accountability": "Model vendor under contract; harness and infrastructure owned by the bank's Financial Crime Technology team",
        "population_scope": "Retail customers in one jurisdiction whose activity raised a monitoring alert"
